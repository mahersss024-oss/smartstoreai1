{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "souqhamad-image-pipeline",
  "account_id": "84eaccd30fc84404472f6e295dd551a9",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SERVER_ORIGIN": "https://souqhamad.com",
    "INTAKE_BUCKET_NAME": "souqhamad-image-intake"
  },
  // IMAGE_WORKER_SECRET is supplied using `wrangler secret put`, never here.
  "r2_buckets": [
    { "binding": "INTAKE", "bucket_name": "souqhamad-image-intake" }
  ],
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": ["17 * * * *"] },
  "queues": {
    "consumers": [{
      "queue": "souqhamad-image-uploads",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      // Delivery retries include busy/lost-response leases; server-side image
      // processing attempts are independently limited to five.
      "max_retries": 20,
      "max_concurrency": 2,
      "dead_letter_queue": "souqhamad-image-uploads-dlq"
    }]
  },
  "observability": { "enabled": true }
}
