{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "souqhamad-recovery",
  "account_id": "84eaccd30fc84404472f6e295dd551a9",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  // Provision a dedicated HTTPS custom domain before enabling the server proxy.
  // Supply RECOVERY_WORKER_SECRET via wrangler secret put, never source control.
  "vars": { "RECOVERY_MEDIA_ENABLED": "0" },
  // Source bindings are NOT read-only IAM grants. This Worker only calls list/get
  // on them. Isolate vault credentials, script-edit permissions and public access.
  // Do not add bucket locks or automatic deletion to legal evidence by default.
  "r2_buckets": [
    { "binding": "LISTINGS", "bucket_name": "souq-hamad-listings" },
    { "binding": "EVIDENCE", "bucket_name": "souqhamad-evidence" },
    { "binding": "INTAKE", "bucket_name": "souqhamad-image-intake" },
    { "binding": "VAULT", "bucket_name": "souqhamad-recovery-vault" }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "souqhamad-recovery-jobs" }],
    "consumers": [{ "queue": "souqhamad-recovery-jobs", "max_batch_size": 1,
      "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 20,
      "dead_letter_queue": "souqhamad-recovery-jobs-dlq" }]
  },
  "triggers": { "crons": ["41 * * * *"] },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true }
}
