generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  draft
  pending
  published
  paused
  sold
  rejected
  deleted
}

enum ListingCondition {
  new
  used
  like_new
  damaged
}

enum ListingImageStatus {
  pending_review
  approved
  needs_retake
  rejected
}

enum ConversationStatus {
  open
  closed
  reported
}

enum ConversationMessageStatus {
  sent
  blocked
}

enum ReportStatus {
  open
  reviewed
  dismissed
}

enum CommissionStatus {
  pending_amount
  due
  paid
  waived
  disputed
}

enum CommissionSource {
  site_sale
}

enum AdminAuditAction {
  approve_listing
  reject_listing
  delete_listing
  review_report
  dismiss_report
  update_commission
}

model User {
  id                          String                  @id
  email                       String                  @unique
  name                        String?
  picture                     String?
  role                        String                  @default("user")
  commissionAgreementVersion  String?
  commissionAgreementAccepted DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  listings                    Listing[]               @relation("SellerListings")
  buyerConversations          Conversation[]          @relation("BuyerConversations")
  sellerConversations         Conversation[]          @relation("SellerConversations")
  messages                    ConversationMessage[]
  favorites                   Favorite[]
  reports                     Report[]                @relation("ReporterReports")
  commissions                 Commission[]
  adminAuditLogs              AdminAuditLog[]

  @@index([email])
}

model Listing {
  id               String              @id @default(cuid())
  sellerId         String
  category         String
  title            String?
  description      String?
  price            Decimal?            @db.Decimal(12, 2)
  priceMode        String?
  city             String?
  condition        ListingCondition?
  attributes       Json                @default("{}")
  searchText       String?             @db.Text
  status           ListingStatus       @default(draft)
  compliance       Json                @default("{}")
  views            Int                 @default(0)
  messageCount     Int                 @default(0)
  favoriteCount    Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  seller           User                @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  images           ListingImage[]
  conversations    Conversation[]
  favorites        Favorite[]
  reports          Report[]
  commissions      Commission[]

  @@index([sellerId, status])
  @@index([status, updatedAt])
  @@index([category, city])
}

model MarketplaceSearchState {
  id        String   @id @default(cuid())
  ownerKey  String   @unique
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ApiIdempotencyKey {
  id         String   @id @default(cuid())
  namespace  String
  actorKey   String
  key        String
  status     String   @default("pending")
  statusCode Int?
  response   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([namespace, actorKey, key])
  @@index([createdAt])
}

model ListingImage {
  id             String             @id @default(cuid())
  listingId      String
  originalUrl    String
  displayUrl     String
  thumbnailUrl   String
  isPrimary      Boolean            @default(false)
  qualityScore   Int
  status         ListingImageStatus
  enhancements   String[]           @default([])
  createdAt      DateTime           @default(now())

  listing        Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, isPrimary])
}

model Conversation {
  id          String                  @id @default(cuid())
  listingId   String
  sellerId    String
  buyerId     String
  status      ConversationStatus      @default(open)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  listing     Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller      User                    @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer       User                    @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]

  @@unique([listingId, sellerId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model ConversationMessage {
  id             String                    @id @default(cuid())
  conversationId String
  senderId       String
  body           String                    @db.VarChar(1000)
  status         ConversationMessageStatus @default(sent)
  reasons        String[]                  @default([])
  createdAt      DateTime                  @default(now())

  conversation   Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([listingId])
}

model Commission {
  id                    String           @id @default(cuid())
  listingId             String
  sellerId              String
  productValue          Decimal?         @db.Decimal(12, 2)
  commissionRatePercent Decimal          @default(1) @db.Decimal(5, 2)
  commissionAmount      Decimal?         @db.Decimal(12, 2)
  status                CommissionStatus @default(pending_amount)
  source                CommissionSource @default(site_sale)
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  listing               Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller                User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([listingId])
  @@index([sellerId, status])
  @@index([status, updatedAt])
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  adminId    String
  action     AdminAuditAction
  targetType String
  targetId   String
  metadata   Json             @default("{}")
  createdAt  DateTime         @default(now())

  admin      User             @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}
