generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  draft
  pending
  published
  paused
  sold
  rejected
  deleted
}

enum ListingCondition {
  new
  used
  like_new
  damaged
}

enum ListingImageStatus {
  pending_review
  approved
  needs_retake
  rejected
}

enum ConversationStatus {
  open
  closed
  reported
}

enum ConversationMessageStatus {
  sent
  blocked
}

enum ReportStatus {
  open
  reviewed
  dismissed
}

enum CommissionStatus {
  pending_amount
  due
  paid
  waived
  disputed
}

enum CommissionSource {
  site_sale
}

enum AdminAuditAction {
  manage_evidence
  approve_listing
  update_listing
  reject_listing
  delete_listing
  review_report
  dismiss_report
  update_commission
  update_user
  delete_user
  warn_user
  restrict_conversation
  maintenance_cleanup
  update_site_message
}

enum SiteMessageType {
  info
  warning
  maintenance
}

model User {
  id                          String    @id
  email                       String    @unique
  name                        String?
  picture                     String?
  phoneNumber                 String?   @db.VarChar(32)
  phoneUpdatedAt              DateTime?
  role                        String    @default("user")
  commissionAgreementVersion  String?
  commissionAgreementAccepted DateTime?
  platformAgreementVersion    String?
  platformAgreementAccepted   DateTime?
  termsVersion                String?
  privacyPolicyVersion        String?
  listingPolicyVersion        String?
  commissionPolicyVersion     String?
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  lastActiveAt                DateTime?

  listings              Listing[]             @relation("SellerListings")
  buyerConversations    Conversation[]        @relation("BuyerConversations")
  sellerConversations   Conversation[]        @relation("SellerConversations")
  messages              ConversationMessage[]
  favorites             Favorite[]
  reports               Report[]              @relation("ReporterReports")
  userReportsCreated    UserReport[]          @relation("UserReportsCreated")
  userReportsReceived   UserReport[]          @relation("UserReportsReceived")
  userBlocksCreated     UserBlock[]           @relation("UserBlocksCreated")
  userBlocksReceived    UserBlock[]           @relation("UserBlocksReceived")
  sellerFollowsCreated  SellerFollow[]        @relation("SellerFollowsCreated")
  sellerFollowsReceived SellerFollow[]        @relation("SellerFollowsReceived")
  sellerRatingsCreated  SellerRating[]        @relation("SellerRatingsCreated")
  sellerRatingsReceived SellerRating[]        @relation("SellerRatingsReceived")
  commissions           Commission[]
  adminAuditLogs        AdminAuditLog[]
  siteMessagesUpdated   SiteMessage[]         @relation("SiteMessageUpdatedBy")
  pushSubscriptions     PushSubscription[]
  mobilePushTokens      MobilePushToken[]
  followNotifications   FollowNotification[]
  similarListingFollows SimilarListingFollow[]

  @@index([email])
  @@index([deletedAt, lastActiveAt])
}

model Listing {
  id            String            @id @default(cuid())
  sellerId      String
  category      String
  title         String?
  description   String?
  price         Decimal?          @db.Decimal(12, 2)
  priceMode     String?
  city          String?
  condition     ListingCondition?
  attributes    Json              @default("{}")
  searchText    String?           @db.Text
  status        ListingStatus     @default(draft)
  compliance    Json              @default("{}")
  views         Int               @default(0)
  messageCount  Int               @default(0)
  favoriteCount Int               @default(0)
  firstPublicationTracked Boolean @default(false)
  firstPublishedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  seller        User           @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  images        ListingImage[]
  conversations Conversation[]
  favorites     Favorite[]
  reports       Report[]
  commissions   Commission[]
  followNotifications FollowNotification[]
  similarListingFollows SimilarListingFollow[]

  @@index([sellerId, status])
  @@index([status, updatedAt])
  @@index([status, category, city, updatedAt])
  @@index([category, city])
}

model MarketplaceSearchState {
  id        String   @id @default(cuid())
  ownerKey  String   @unique
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ApiIdempotencyKey {
  id         String   @id @default(cuid())
  namespace  String
  actorKey   String
  key        String
  status     String   @default("pending")
  statusCode Int?
  response   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([namespace, actorKey, key])
  @@index([createdAt])
}

model SiteVisitDaily {
  day            String   @id
  visits         Int      @default(0)
  uniqueVisitors Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteVisitUnique {
  id        String   @id @default(cuid())
  day       String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([day, visitorId])
  @@index([day, createdAt])
}

enum PushPlatform {
  web
  ios
  android
}

model PushSubscription {
  id         String       @id @default(cuid())
  userId     String?
  endpoint   String       @unique
  p256dh     String
  auth       String
  platform   PushPlatform @default(web)
  userAgent  String?
  locale     String?
  isActive   Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, updatedAt])
}

enum MobilePushPlatform {
  ios
  android
}

model MobilePushToken {
  id         String             @id @default(cuid())
  userId     String
  token      String             @unique
  platform   MobilePushPlatform
  appVersion String?
  locale     String?
  userAgent  String?
  isActive   Boolean            @default(true)
  lastSeenAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([platform, isActive])
  @@index([isActive, updatedAt])
}

model ListingImage {
  contentReviewStatus String?
  id           String             @id @default(cuid())
  listingId    String
  originalUrl  String
  displayUrl   String
  thumbnailUrl String
  isPrimary    Boolean            @default(false)
  qualityScore Int
  status       ListingImageStatus
  enhancements String[]           @default([])
  createdAt    DateTime           @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, isPrimary])
  @@index([listingId, status, isPrimary])
}

enum ListingImageUploadStatus {
  pending
  processing
  ready
  failed
  cancelled
  expired
}

model ListingImageUpload {
  id                 String @id
  listingId          String
  sellerId           String
  idempotencyKey     String @db.VarChar(200)
  requestFingerprint String @db.Char(64)
  fileName           String @db.VarChar(200)
  mediaType          String @default("image/jpeg")
  sizeBytes          Int
  sha256             String @db.Char(64)
  sourceKey          String
  originalKey        String
  displayKey         String
  thumbnailKey       String
  status             ListingImageUploadStatus @default(pending)
  errorCode          String? @db.VarChar(80)
  attempts           Int @default(0)
  expiresAt          DateTime
  leaseToken         String?
  leaseUntil         DateTime?
  readyAt            DateTime?
  cleanupAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sellerId, listingId, idempotencyKey])
  @@index([listingId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([status, cleanupAt])
}

// Storage cleanup survives image/listing/account deletion and process restarts.
// URLs enter only from a server-authorized image deletion, never request bodies.
model ImageObjectCleanup {
  id            String   @id @default(cuid())
  imageId       String   @unique
  ownerId       String?
  urls          String[]
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  leaseToken    String?
  leaseUntil    DateTime?
  cleanupAt     DateTime?
  createdAt     DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt     DateTime @updatedAt

  @@index([cleanupAt, nextAttemptAt])
}

model Conversation {
  id        String             @id @default(cuid())
  listingId String
  sellerId  String
  buyerId   String
  status    ConversationStatus @default(open)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  listing     Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller      User                  @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer       User                  @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]
  userReports UserReport[]
  userBlocks  UserBlock[]

  @@unique([listingId, sellerId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model ConversationMessage {
  id             String                    @id @default(cuid())
  conversationId String
  senderId       String
  body           String                    @db.VarChar(1000)
  status         ConversationMessageStatus @default(sent)
  type           String                    @default("text") @db.VarChar(32)
  reasons        String[]                  @default([])
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([listingId])
}

model UserReport {
  id             String       @id @default(cuid())
  reporterId     String
  targetUserId   String
  conversationId String?
  reason         String       @db.VarChar(120)
  details        String?      @db.VarChar(1000)
  status         ReportStatus @default(open)
  resolution     String?      @db.VarChar(32)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User          @relation("UserReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User          @relation("UserReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId, status])
  @@index([conversationId])
  @@index([resolvedBy])
}

model UserBlock {
  id             String   @id @default(cuid())
  blockerId      String
  blockedId      String
  conversationId String?
  reason         String?  @db.VarChar(120)
  createdAt      DateTime @default(now())

  blocker      User          @relation("UserBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked      User          @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@index([conversationId])
}

model SellerFollow {
  id         String   @id @default(cuid())
  followerId String
  sellerId   String
  createdAt  DateTime @default(now())

  follower User @relation("SellerFollowsCreated", fields: [followerId], references: [id], onDelete: Cascade)
  seller   User @relation("SellerFollowsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([followerId, sellerId])
  @@index([sellerId, createdAt])
}

model FollowNotification {
  id        String    @id @default(cuid())
  userId    String
  listingId String
  sellerId  String
  title     String?
  body      String?
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, readAt, createdAt])
  @@index([listingId])
}

model SimilarListingFollow {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  category  String
  city      String?
  title     String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([category, city, createdAt])
}

model SellerRating {
  id        String   @id @default(cuid())
  raterId   String
  sellerId  String
  rating    Int
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rater  User @relation("SellerRatingsCreated", fields: [raterId], references: [id], onDelete: Cascade)
  seller User @relation("SellerRatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([raterId, sellerId])
  @@index([sellerId, createdAt])
}

model Commission {
  id                    String           @id @default(cuid())
  listingId             String
  sellerId              String
  productValue          Decimal?         @db.Decimal(12, 2)
  commissionRatePercent Decimal          @default(1) @db.Decimal(5, 2)
  commissionAmount      Decimal?         @db.Decimal(12, 2)
  status                CommissionStatus @default(pending_amount)
  source                CommissionSource @default(site_sale)
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([listingId])
  @@index([sellerId, status])
  @@index([status, updatedAt])
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  adminId    String?
  action     AdminAuditAction
  targetType String
  targetId   String
  metadata   Json             @default("{}")
  createdAt  DateTime         @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// Evidence deliberately has no foreign keys to deletable marketplace records.
model EvidenceCase {
  id              String   @id @default(cuid())
  sourceType      String
  sourceId        String
  listingId       String?
  participantIds  String[]
  conversationIds String[]
  snapshot        Json
  snapshotHash    String
  status          String   @default("open")
  captureStatus   String   @default("pending")
  closedAt        DateTime?
  retainUntil     DateTime?
  legalHold       Boolean  @default(false)
  disposedAt      DateTime?
  createdAt       DateTime @default(now())
  assets          EvidenceAsset[]
  events          EvidenceEvent[]

  @@unique([sourceType, sourceId])
  @@index([listingId, status])
  @@index([participantIds], type: Gin)
  @@index([conversationIds], type: Gin)
}

model EvidenceAsset {
  id          String   @id @default(cuid())
  caseId      String
  sourceUrl   String
  sourceHash  String
  objectKey   String   @unique
  status      String   @default("pending")
  sha256      String?
  mediaType   String?
  byteLength  Int?
  attempts    Int      @default(0)
  lastError   String?
  leaseUntil  DateTime?
  createdAt   DateTime @default(now())
  evidenceCase EvidenceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, sourceHash])
  @@index([caseId, status])
  @@index([sourceHash, status])
}

model EvidenceEvent {
  id         String   @id @default(cuid())
  caseId     String
  action     String
  actorId    String?
  payload    Json
  createdAt  DateTime @default(now())
  evidenceCase EvidenceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt, id])
}

model SiteMessage {
  id          String          @id @default("primary")
  message     String          @db.VarChar(500)
  type        SiteMessageType @default(info)
  isEnabled   Boolean         @default(false)
  expiresAt   DateTime?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  updatedBy User? @relation("SiteMessageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isEnabled, expiresAt])
}
