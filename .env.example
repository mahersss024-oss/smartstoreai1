# Copy this file to .env.local for local development.
# Never commit real secrets, API keys, database URLs, or OAuth secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave store links empty until an official listing or TestFlight invitation exists.
# Android accepts only Google Play details for com.souqhamad.app.
NEXT_PUBLIC_ANDROID_APP_STORE_URL=
# iOS accepts an apps.apple.com app listing or testflight.apple.com/join invitation.
NEXT_PUBLIC_IOS_APP_STORE_URL=

# App Runner sets PORT from apprunner.yaml. Render may set PORT itself.
# PORT=3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Production should use an RDS/PostgreSQL URL supplied from Secrets Manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require

# Production must use database mode to keep persistence and consistency.
SMARTSTORE_MARKETPLACE_STORE=database
SMARTSTORE_HEALTH_INCLUDE_METRICS=0

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional public client id used by Android Credential Manager.
# If empty, GOOGLE_CLIENT_ID is used as the server client id for native Google sign-in.
GOOGLE_NATIVE_CLIENT_ID=

APPLE_CLIENT_ID=
# Explicit iOS native app bundle identifier; separate from the Apple web Services ID.
APPLE_NATIVE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
SMARTSTORE_ADMIN_EMAILS=admin@example.com
SMARTSTORE_ENABLE_ADMIN_MAINTENANCE_CLEANUP=0

# -----------------------------------------------------------------------------
# DeepSeek
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_SCOPE_MODEL=
DEEPSEEK_SEARCH_MODEL=deepseek-flash
DEEPSEEK_MODERATION_MODEL=
DEEPSEEK_VISION_MODEL=deepseek-flash

SMARTSTORE_DEEPSEEK_MAX_CONCURRENT_REQUESTS=100
SMARTSTORE_DEEPSEEK_MAX_QUEUED_REQUESTS=2000
SMARTSTORE_DEEPSEEK_QUEUE_TIMEOUT_MS=60000
SMARTSTORE_SCOPE_GUARD_TIMEOUT_MS=15000
SMARTSTORE_OUTPUT_SCOPE_GUARD_TIMEOUT_MS=15000
SMARTSTORE_ADAPTIVE_INTENT_TIMEOUT_MS=15000
SMARTSTORE_IMAGE_COMPLIANCE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Marketplace limits
# -----------------------------------------------------------------------------
SMARTSTORE_MAX_IMAGES_PER_LISTING=8
SMARTSTORE_MAX_LISTINGS_PER_SELLER=100

# -----------------------------------------------------------------------------
# Image/object storage
# -----------------------------------------------------------------------------
# Use "s3" when storing listing images in S3-compatible object storage.
SMARTSTORE_IMAGE_STORAGE=
SMARTSTORE_OBJECT_STORAGE_ENDPOINT=
SMARTSTORE_OBJECT_STORAGE_BUCKET=
SMARTSTORE_OBJECT_STORAGE_ACCESS_KEY_ID=
SMARTSTORE_OBJECT_STORAGE_SECRET_ACCESS_KEY=
SMARTSTORE_OBJECT_STORAGE_REGION=auto
SMARTSTORE_OBJECT_STORAGE_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Commission payment information
# -----------------------------------------------------------------------------
SMARTSTORE_COMMISSION_ALRAJHI_ACCOUNT_NAME=
SMARTSTORE_COMMISSION_ALRAJHI_ACCOUNT_NUMBER=
SMARTSTORE_COMMISSION_ALRAJHI_IBAN=

SMARTSTORE_COMMISSION_SNB_ACCOUNT_NAME=
SMARTSTORE_COMMISSION_SNB_ACCOUNT_NUMBER=
SMARTSTORE_COMMISSION_SNB_IBAN=

SMARTSTORE_COMMISSION_STC_PAY_NAME=
SMARTSTORE_COMMISSION_STC_PAY_NUMBER=
SMARTSTORE_COMMISSION_STC_PAY_ACCOUNT=

# -----------------------------------------------------------------------------
# Push notifications
# -----------------------------------------------------------------------------
SMARTSTORE_VAPID_PUBLIC_KEY=
SMARTSTORE_VAPID_PRIVATE_KEY=
SMARTSTORE_VAPID_SUBJECT=

# Native Android push delivery through Firebase Cloud Messaging.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Native iPhone push delivery through Apple Push Notification service.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.souqhamad.app
APNS_USE_SANDBOX=0

# -----------------------------------------------------------------------------
# Rate limiting / cache
# -----------------------------------------------------------------------------
SMARTSTORE_RATE_LIMIT_BACKEND=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SMARTSTORE_PUBLIC_CACHE_REDIS_TIMEOUT_MS=1500

# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# -----------------------------------------------------------------------------
# Optional local readiness checks
# -----------------------------------------------------------------------------
READINESS_BASE_URL=http://localhost:3000
READINESS_JSON=0

# Optional destructive-safe integration test against the configured database.
SMARTSTORE_DB_INTEGRATION=0
