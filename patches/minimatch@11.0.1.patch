+'use strict';
+
+// ESLint 9 and its plugins still call the pre-v9 CommonJS function export.
+// Delegate every operation to the patched upstream implementation, preserving
+// the modern named exports and leaving the ESM entry point unchanged.
+const api = require('./index.js');
+module.exports = Object.assign(api.minimatch, api);
