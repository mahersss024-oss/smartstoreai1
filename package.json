{
  "name": "smartstore-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "readiness": "tsx scripts/readiness-check.ts",
    "test": "node scripts/test.mjs",
    "test:inventory": "tsx scripts/test-inventory.ts",
    "test:coverage": "pnpm test:inventory && node scripts/test.mjs --coverage && tsx scripts/test-coverage-report.ts",
    "test:routes": "playwright test e2e/route-contracts.spec.ts --global-timeout=1200000",
    "test:db:integration": "node scripts/test.mjs tests/db-integration.test.ts tests/evidence-db-integration.test.ts",
    "test:e2e": "playwright test",
    "test:ai-load": "tsx scripts/ai-path-load-test.ts",
    "test:load": "node tests/load/scripts/run-k6.mjs tests/load/scenarios/public-read.js",
    "test:stress": "node tests/load/scripts/run-k6.mjs tests/load/scenarios/stress.js",
    "test:spike": "node tests/load/scripts/run-k6.mjs tests/load/scenarios/spike.js",
    "test:soak": "node tests/load/scripts/run-k6.mjs tests/load/scenarios/soak.js",
    "test:pages": "node tests/load/scripts/run-k6.mjs tests/load/scenarios/page-flow.js",
    "test:images": "node tests/load/scripts/run-k6.mjs tests/load/images/image-flow.js",
    "test:browser": "playwright test -c tests/load/browser/playwright.config.ts",
    "test:load:chat": "node tests/load/scripts/run-k6.mjs tests/load/api/chat-read.js",
    "test:load:writes": "node tests/load/scripts/run-k6.mjs tests/load/api/write-smoke.js",
    "images:orphans:dry-run": "tsx scripts/r2-orphaned-listing-images-dry-run.ts",
    "images:missing:dry-run": "tsx scripts/repair-missing-listing-images.ts",
    "images:missing:apply": "tsx scripts/repair-missing-listing-images.ts --apply",
    "images:variants:dry-run": "tsx scripts/backfill-listing-image-variants.ts",
    "images:variants:apply": "tsx scripts/backfill-listing-image-variants.ts --apply",
    "verify": "pnpm exec tsc --noEmit && pnpm lint && pnpm test && pnpm build && pnpm audit --audit-level moderate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.65",
    "@ai-sdk/react": "4.0.100",
    "@fullcalendar/react": "7.1.3",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "7.0.97",
    "apexcharts": "7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.553.0",
    "nanoid": "^6.0.1",
    "next": "16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-apexcharts": "2.1.1",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.20.6",
    "use-stick-to-bottom": "^1.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@next/eslint-plugin-next@16.4.0>fast-glob": "npm:tinyglobby@0.2.17",
      "@humanfs/node@<0.16.8": "0.16.8",
      "@babel/core": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "browserslist": "4.28.7",
      "flatted@<=3.4.1": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "mdast-util-to-hast": "13.2.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.23": "8.5.23",
      "source-map-js@<1.2.2": "1.2.2"
    },
    "patchedDependencies": {
      "@next/eslint-plugin-next@16.4.0": "patches/@next__eslint-plugin-next@16.4.0.patch"
    }
  }
}
